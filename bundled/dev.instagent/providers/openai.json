{
  "name": "openai",
  "engine": "openai",
  "display_name": "OpenAI",
  "description": "OpenAI Chat Completions (gpt-5 / gpt-4.1 / o series)",
  "api_key_env": "OPENAI_API_KEY",
  "base_url": "https://api.openai.com/v1",
  "headers": {},
  "timeout_seconds": 600,
  "models": [
    { "name": "gpt-5", "context_limit": 400000, "max_tokens": 32000 },
    { "name": "gpt-5-mini", "context_limit": 400000, "max_tokens": 32000 },
    { "name": "gpt-4.1", "context_limit": 1047576, "max_tokens": 32000 },
    { "name": "gpt-4o", "context_limit": 128000, "max_tokens": 16384 },
    { "name": "o3", "context_limit": 200000, "max_tokens": 100000 }
  ]
}
