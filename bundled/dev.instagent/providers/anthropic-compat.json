{
  "name": "anthropic-compat",
  "engine": "openai",
  "display_name": "Anthropic (OpenAI-compat)",
  "description": "Anthropic 官方 OpenAI 兼容端点（openai 引擎打 /v1/chat/completions）。官方限制：无 prompt caching、tool `strict` 被忽略、thinking 内容不返回；需要这些能力请走 proxy（11）或原生 anthropic engine（12）。",
  "api_key_env": "ANTHROPIC_API_KEY",
  "base_url": "https://api.anthropic.com/v1",
  "headers": {},
  "timeout_seconds": 600,
  "models": [
    { "name": "claude-sonnet-4-6", "context_limit": 1000000, "max_tokens": 64000 },
    { "name": "claude-opus-4-7", "context_limit": 200000, "max_tokens": 32000 },
    { "name": "claude-haiku-4-5", "context_limit": 200000, "max_tokens": 8192 }
  ]
}
